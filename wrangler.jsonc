{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apps",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "worker/src/index.js",
	"assets": {
		"directory": ".",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "GLOBE_LINKS",
			"id": "d5b6ef3c82084c6c8f6bd5e82538cfaf",
			"remote": true
		},
		{
			"binding": "ARAM_META_KV",
			// TODO: replace with the real namespace id before deploying —
			// run `npx wrangler kv namespace create ARAM_META_KV` and paste the id here.
			"id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID",
			"remote": true
		}
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "EDH_CLOCK",
				"class_name": "EDHClock"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EDHClock"]
		}
	],
	"unsafe": {
		"bindings": [
			{
				"type": "ratelimit",
				"name": "LIMITER",
				"namespace_id": "1001",
				"simple": {
					"limit": 10,
					"period": 600
				}
			}
		]
	}
}
